table _measures
	lineageTag: e07f4708-e880-4f17-a5bf-48cf2c6faa1d

	measure 'Total Calls' = COUNTROWS('insightal_analytics fact_calls')
		lineageTag: 6bf53c41-0ffb-4928-8075-aabebe5aa658

	measure 'Connected Calls' = CALCULATE([Total Calls], 'insightal_analytics fact_calls'[connection_status] = "Connected")
		lineageTag: 58f33d7e-fa19-4471-af1b-31499d626a1a

	measure 'Connection Rate' = DIVIDE([Connected Calls], [Total Calls])
		lineageTag: 0f07d681-54a8-4968-b596-59d26c095c6a

	measure 'Intent Recognition Accuracy' = DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_conversation'), 'insightal_analytics fact_conversation'[speaker] = "Customer", NOT ISBLANK('insightal_analytics fact_conversation'[expected_intent_key]), NOT ISBLANK('insightal_analytics fact_conversation'[detected_intent_key]), 'insightal_analytics fact_conversation'[expected_intent_key] = 'insightal_analytics fact_conversation'[detected_intent_key]), CALCULATE(COUNTROWS('insightal_analytics fact_conversation'), 'insightal_analytics fact_conversation'[speaker] = "Customer", NOT ISBLANK('insightal_analytics fact_conversation'[expected_intent_key]), NOT ISBLANK('insightal_analytics fact_conversation'[detected_intent_key])))
		lineageTag: b7fa2400-dec8-4406-99ce-f68e2e491972

	measure 'Fallback Rate' = DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_conversation'), 'insightal_analytics fact_conversation'[fallback_flag] = TRUE()), COUNTROWS('insightal_analytics fact_conversation'))
		lineageTag: 8080d548-1f64-469d-84e8-2000c4e6122e

	measure 'Collection Conversion Rate' = DIVIDE(CALCULATE(DISTINCTCOUNT('insightal_analytics fact_calls'[customer_key]), 'insightal_analytics fact_calls'[ptp_flag] = TRUE(), 'insightal_analytics fact_calls'[payment_status] = "Success"), CALCULATE(DISTINCTCOUNT('insightal_analytics fact_calls'[customer_key]), 'insightal_analytics fact_calls'[ptp_flag] = TRUE()))
		lineageTag: 4d95b1fe-4d7f-4aad-a393-8be77bb40632

	measure 'Outstanding Amount' = CALCULATE(SUMX(VALUES('insightal_analytics fact_calls'[customer_key]), VAR MaxTime = CALCULATE(MAX('insightal_analytics fact_calls'[call_start_time])) RETURN CALCULATE(MAX('insightal_analytics fact_calls'[outstanding_amount_at_call]), 'insightal_analytics fact_calls'[call_start_time] = MaxTime)), 'insightal_analytics fact_calls'[connection_status] = "Connected", 'insightal_analytics dim_campaign'[campaign_type] = "Loan Collections")
		lineageTag: e2b846d7-38a0-438f-bcda-60242dcdc6c1

	measure 'Outstanding Collected Ratio' = DIVIDE([Successful Collection Amount], [Outstanding Amount])
		lineageTag: 6daac899-ba33-4f99-9c2f-d7ddea69d830

	measure 'Agent Calls Avoided' = CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[containment_flag] = TRUE())
		lineageTag: 9aa9e3f9-b973-429c-b868-640690476074

	measure 'Agent Hours Freed' = DIVIDE([Agent Calls Avoided] * [WhatIf_AgentCallDuration Value], 3600)
		lineageTag: 81c475eb-7142-4859-ac76-e3bdb53fd495

	measure 'FTE Capacity Freed' = DIVIDE([Agent Hours Freed], [WhatIf_ProductiveHours Value] * 30)
		lineageTag: 6d20ee66-3f91-4470-a273-1853fcf66068

	measure 'Estimated Operational Cost Avoided' = [Agent Calls Avoided] * [WhatIf_CostPerCall Value]
		lineageTag: 2ce8e8a4-4857-467a-a48e-13ff16223687

	measure 'Successful Collection Amount' = CALCULATE(SUM('insightal_analytics fact_calls'[payment_amount]), 'insightal_analytics fact_calls'[payment_status] = "Success", 'insightal_analytics dim_campaign'[campaign_type] = "Loan Collections")
		lineageTag: 4a7202b1-9c38-45fc-ac44-4de74fff3cd4

	measure 'Average Call Duration' = AVERAGE('insightal_analytics fact_calls'[call_duration_seconds])
		lineageTag: b0f160cd-e762-40de-893d-44642a51fa96

	measure 'Median Call Duration' = MEDIAN('insightal_analytics fact_calls'[call_duration_seconds])
		lineageTag: c9e76c94-0be5-4fa1-a99c-2d524a092d59

	measure 'Average Attempts' = AVERAGEX(VALUES('insightal_analytics dim_customer'[customer_key]), CALCULATE(MAX('insightal_analytics fact_calls'[attempt_number])))
		lineageTag: 7c7f4e6d-10e0-465e-9b39-ea106bcf0e55

	measure 'Task Completion Rate' = DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[task_completed_flag]=TRUE()), [Connected Calls])
		lineageTag: 27cb5625-5fc9-4422-a8d2-3684b01131c5

	measure 'Resolution Rate' = DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[resolution_flag]=TRUE()), [Connected Calls])
		lineageTag: 346a5827-50d2-4f77-916b-a1d9e419fcc9

	measure 'Containment Rate' = DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[containment_flag]=TRUE()), [Connected Calls])
		lineageTag: ddddd0bd-8902-45fe-8f1f-1cc185754ab4

	measure 'Escalation Rate' = DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[escalation_flag]=TRUE()), [Connected Calls])
		lineageTag: d5aa220f-4e10-411d-aede-89d96f105450

	measure 'Average Confidence' = AVERAGE('insightal_analytics fact_conversation'[confidence_score])
		lineageTag: 55394b2e-3a20-4135-bc36-23dfbe08afa5

	measure 'Normalized Sentiment' = DIVIDE(AVERAGE('insightal_analytics fact_calls'[sentiment_score]) + 1, 2)
		lineageTag: 360f896a-45ce-43d3-b0d5-d9393b572b0c

	measure 'Conversation Satisfaction Proxy' = (0.4 * [Resolution Rate]) + (0.3 * [Containment Rate]) + (0.2 * [Normalized Sentiment]) + (0.1 * [Task Completion Rate])
		lineageTag: 8aadb082-cb36-4551-90f5-9068a2a1aaa7

	measure Reliability = 1 - DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[hangup_reason] = "System Error"), [Connected Calls])
		lineageTag: f698da8c-381b-4a37-aa31-5841a4dd9ea0

	measure 'Project-defined Bot Quality Score' = (0.3 * [Containment Rate]) + (0.25 * [Task Completion Rate]) + (0.2 * [Intent Recognition Accuracy]) + (0.15 * [Conversation Satisfaction Proxy]) + (0.1 * [Reliability])
		lineageTag: 0ff82d83-a094-4550-a80f-acf16e99e02b

	measure 'Total Collections Calls' = CALCULATE([Total Calls], 'insightal_analytics dim_campaign'[campaign_type] = "Loan Collections")
		lineageTag: ab06b14e-64d2-4b4e-9629-5a0662b8cfce

	measure 'Connected Collections Calls' = CALCULATE([Connected Calls], 'insightal_analytics dim_campaign'[campaign_type] = "Loan Collections")
		lineageTag: b10b0cb0-c9d5-4e97-a591-f90526716ca8

	measure 'Contact Rate' = DIVIDE([Connected Collections Calls], [Total Collections Calls])
		lineageTag: 53a84970-304e-45c5-a6ea-22e430e02446

	measure 'PTP Rate' = DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[ptp_flag]=TRUE(), 'insightal_analytics dim_campaign'[campaign_type] = "Loan Collections"), [Connected Collections Calls])
		lineageTag: dcbaf81f-4baf-42ba-9ca1-676ce0322f43

	measure 'Successful PTP Rate' = DIVIDE(CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[payment_status] = "Success", 'insightal_analytics fact_calls'[ptp_flag] = TRUE(), 'insightal_analytics dim_campaign'[campaign_type] = "Loan Collections"), CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[ptp_flag] = TRUE(), 'insightal_analytics dim_campaign'[campaign_type] = "Loan Collections"))
		lineageTag: 0abc3b66-f58c-4bbf-8848-b454f63457e6

	measure 'PTP Amount' = CALCULATE(SUM('insightal_analytics fact_calls'[ptp_amount]), 'insightal_analytics dim_campaign'[campaign_type] = "Loan Collections")
		lineageTag: 63adbbeb-ae81-47e4-9442-d9c8f8f0ae18

	measure 'Actual Contained Calls' = CALCULATE(COUNTROWS('insightal_analytics fact_calls'), 'insightal_analytics fact_calls'[containment_flag] = TRUE())
		lineageTag: 81b102b9-cd60-4a71-aec8-b0a6c40b1d25

	measure 'Actual Agent Calls Avoided' = [Actual Contained Calls]
		lineageTag: 37a75894-1d5c-4f3b-bae0-7643beac15bc

	measure 'Scenario Containment Rate' = [Containment Rate] + [WhatIf_ContainmentImprovement Value]
		lineageTag: 6f68a98d-0709-469a-afdf-e6772d825d8e

	measure 'Scenario Additional Contained Calls' = [Connected Calls] * [WhatIf_ContainmentImprovement Value]
		lineageTag: a2c0367a-d492-46b9-a58d-3357efb6a7f9

	measure 'Scenario Total Contained Calls' = [Actual Contained Calls] + [Scenario Additional Contained Calls]
		lineageTag: 83618294-fc69-4344-9524-59c24247e39b

	measure 'Scenario Additional Agent Hours Freed' = DIVIDE([Scenario Additional Contained Calls] * [WhatIf_AgentCallDuration Value], 3600)
		lineageTag: 0b876559-4521-4f70-89cf-53d99e598a65

	measure 'Scenario Additional Cost Avoided' = [Scenario Additional Contained Calls] * [WhatIf_CostPerCall Value]
		lineageTag: 23fcc5cb-6196-4817-af02-1882487b4bd0

	column Column
		isHidden
		lineageTag: 248810f8-7779-49d5-b99e-11ac0dad2c66
		isNameInferred
		sourceColumn: [Column]

	partition _measures = calculated
		mode: import
		source = ROW("Column", BLANK())

